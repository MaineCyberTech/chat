# API environment variables (local development)
# Copy this to .env and fill in your values

# Core
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000

# Supabase (required)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<your-local-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-local-service-role-key>

# Redis (optional - for idempotency, presence, rate limiting)
REDIS_URL=redis://localhost:6379

# API / Frontend URLs
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=

# SMTP / Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mainecybertech.com

# VAPID Keys for Push Notifications (optional - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=