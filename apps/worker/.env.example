# Worker environment variables (local development)
# Copy this to .env and fill in your values

# Supabase (required)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<your-local-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-local-service-role-key>

# Redis (required - for BullMQ job queues)
REDIS_URL=redis://localhost:6379

# Logging (optional, default shown)
LOG_LEVEL=debug

# HTTP server port (optional, default shown)
PORT=4100

# Sentry (optional - error tracking)
SENTRY_DSN=

# VAPID Keys for Push Notifications (optional - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMTP / Email (optional - for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mainecybertech.com
