{
    auto_https off
}

http://chat.mainecybertech.us {
    reverse_proxy web:3000
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

http://chat-api.mainecybertech.us {
    reverse_proxy api:4000
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}