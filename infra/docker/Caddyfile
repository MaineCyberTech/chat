chat.mainecybertech.us {
    handle /health* {
        reverse_proxy api:4000
    }
    handle /healthz* {
        reverse_proxy api:4000
    }
    handle /v1/auth* {
        reverse_proxy api:4000
    }
    handle /v1/workspaces* {
        reverse_proxy api:4000
    }
    handle /v1/channels* {
        reverse_proxy api:4000
    }
    handle /v1/messages* {
        reverse_proxy api:4000
    }
    handle /v1/webhooks* {
        reverse_proxy api:4000
    }
    handle /v1/notifications* {
        reverse_proxy api:4000
    }
    handle /v1/preferences* {
        reverse_proxy api:4000
    }
    handle /v1/reactions* {
        reverse_proxy api:4000
    }
    handle /socket.io* {
        reverse_proxy api:4000
    }
    reverse_proxy web:3000
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

chat-api.mainecybertech.us {
    reverse_proxy api:4000
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
