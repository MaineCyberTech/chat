{
    # Development Caddyfile — no TLS, plain HTTP
    admin off
    http_port 80
    https_port 443
}

localhost:80 {
    # Security headers (relaxed for dev)
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Static assets with caching
    @static {
        path /_next/static/*
        path /static/*
        path /manifest.json
        path /sw.js
    }
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        root * /var/www/web
        file_server
    }

    # API routes -> API container
    @api {
        path /v1/*
    }
    handle @api {
        reverse_proxy api:4000
    }

    # Health check
    @health {
        path /health*
    }
    handle @health {
        reverse_proxy api:4000
    }

    # LiveKit WebSocket signaling
    @livekit_ws {
        path /v1/livekit/*
        header Connection *Upgrade*
    }
    handle @livekit_ws {
        reverse_proxy livekit:7880
    }

    # LiveKit HTTP signaling
    @livekit {
        path /v1/livekit/*
    }
    handle @livekit {
        reverse_proxy livekit:7880
    }

    # Next.js app
    handle {
        reverse_proxy web:3000
    }
}
