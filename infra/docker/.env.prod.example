# Production Environment
# Copy to .env.prod and fill in values

# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Self-hosted data plane (docs/adr/0002-postgres-postgrest-custom-auth.md)
# After migrating, point the three Supabase vars above at the local data plane:
#   SUPABASE_URL=https://chat.mainecybertech.com     (proxied to PostgREST /rest/v1)
#   NEXT_PUBLIC_SUPABASE_URL=https://chat.mainecybertech.com
#   SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY    (minted JWTs, not API keys)
# Mint those two tokens with:
#   JWT_SECRET=<32+ chars> node scripts/db/mint-keys.mjs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=chat
DATABASE_URL=postgres://postgres:<password>@postgres:5432/chat
JWT_SECRET=

# Apply the schema (bootstrap first, then migrations):
#   DATABASE_URL=... node scripts/db/apply-migrations.mjs

# Back up the database and restore with:
#   docker exec chat-postgres-prod pg_dump -U postgres chat > backup.sql
#   see docs/runbooks/backup-strategy.md

# Object storage (S3-compatible — the MinIO fork "Silo" in docker-compose.prod.yml).
# REQUIRED in production: S3_ACCESS_KEY / S3_SECRET_KEY are also the MinIO root
# credentials, so use strong values (e.g. openssl rand -hex 24).
# S3_ENDPOINT is internal to the compose network; S3_PUBLIC_URL is what browsers
# see and must include the bucket name (Caddy proxies /storage/v1 to MinIO).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=chat-uploads
S3_PUBLIC_URL=https://chat.mainecybertech.com/storage/v1/chat-uploads
# Presigned (direct browser upload) URLs are signed over the Host header and
# path, so they must use a host that maps 1:1 to MinIO with no path prefix.
# Requires a DNS record for this name. Leave unset to sign against the internal
# endpoint (only usable inside the compose network).
S3_PRESIGN_ENDPOINT=https://chat-storage.mainecybertech.com
S3_FORCE_PATH_STYLE=true
# The bucket is private; message-image embeds only render anonymously after:
#   docker exec chat-minio-prod mc anonymous set download local/chat-uploads

# Frontend
NEXT_PUBLIC_API_URL=https://chat.mainecybertech.com
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_APP_URL=https://chat.mainecybertech.com

# API
PORT=4000
NODE_ENV=production
API_BASE_URL=https://chat.mainecybertech.com
FRONTEND_URL=https://chat.mainecybertech.com

# LiveKit (WebRTC — generate keys with: python scripts/generate-livekit-keys.py)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web Push (VAPID keys - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Webhook signing-secret encryption (required; min 32 chars). The API uses this
# to encrypt stored webhook endpoint secrets and the worker uses the same key to
# decrypt them before signing deliveries. Both api and worker must share it.
# Generate with: openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY=

# Metrics scraper token (min 16 chars). When set, GET /metrics on api/worker
# requires it in the x-metrics-token header. Leave unset to disable /metrics.
METRICS_TOKEN=

# Alerting (Alertmanager -> ntfy, OBS-P1-001). CHAT_NTFY_URL/USER default to the
# chat-alerts topic and the write-only chat-relay user; CHAT_NTFY_PASS is
# required and must match that user on ntfy.mainecybertech.us.
CHAT_NTFY_URL=https://ntfy.mainecybertech.us/chat-alerts
CHAT_NTFY_USER=chat-relay
CHAT_NTFY_PASS=

# Docker images (optional — defaults to ghcr.io/mainecybertech/chat)
# WEB_IMAGE=ghcr.io/<owner>/chat/web:latest
# API_IMAGE=ghcr.io/<owner>/chat/api:latest
