{
    admin off
    http_port 80
    https_port 443
}

chat.mainecybertech.com {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    @static {
        path /_next/static/*
        path /static/*
        path /manifest.json
        path /sw.js
    }
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        root * /var/www/web
        file_server
    }

    # Self-hosted PostgREST. `handle_path` strips the /rest/v1 prefix, which is
    # exactly the base path the Supabase JS client appends to SUPABASE_URL.
    handle_path /rest/v1/* {
        reverse_proxy postgrest:3000
    }

    # Self-hosted object storage (S3-compatible). `handle_path` strips the
    # /storage/v1 prefix, matching the object URLs the API returns.
    handle_path /storage/v1/* {
        reverse_proxy minio:9000
    }

    @api {
        path /v1/*
    }
    @socketio_ws {
        path /v1/socket.io/*
        header Connection *Upgrade*
    }
    handle @socketio_ws {
        reverse_proxy api:4000 {
            transport http {
                dial_timeout 10s
                response_header_timeout 0
            }
            flush_interval -1
        }
    }
    handle @api {
        reverse_proxy api:4000
    }

    @health {
        path /health /healthz
    }
    handle @health {
        reverse_proxy api:4000
    }

    @livekit_ws {
        path /v1/livekit/*
        header Connection *Upgrade*
    }
    handle @livekit_ws {
        reverse_proxy livekit:7880
    }

    @livekit {
        path /v1/livekit/*
    }
    handle @livekit {
        reverse_proxy livekit:7880
    }

    handle {
        reverse_proxy web:3000
    }
}

# Dedicated storage host. This must map 1:1 to MinIO with NO path prefix:
# presigned URLs are signed over the Host header and request path (SigV4), so a
# prefix-stripping route such as /storage/v1 would invalidate the signature.
# Browsers upload directly to presigned URLs generated against this host
# (S3_PRESIGN_ENDPOINT). Requires a DNS record for this name.
chat-storage.mainecybertech.com {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
    reverse_proxy minio:9000
}
