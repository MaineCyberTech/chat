# Development Environment
# Copy to .env.dev and adjust values for your local setup

# Supabase (local CLI defaults)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=REPLACE_ME_FROM_SUPABASE_CLI
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_FROM_SUPABASE_CLI

# Redis
REDIS_URL=redis://redis:6379

# LiveKit (WebRTC — generate dev keys as needed)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# API
API_ORIGIN=http://api:4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:80
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_FROM_SUPABASE_CLI
NEXT_PUBLIC_APP_URL=http://localhost:80
