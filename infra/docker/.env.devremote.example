# Development Remote Environment
# Copy to .env.devremote and fill in values

# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Frontend
NEXT_PUBLIC_API_URL=https://chat-api.mainecybertech.us
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_APP_URL=https://chat.mainecybertech.us

# API
PORT=4000
NODE_ENV=development
API_BASE_URL=https://chat-api.mainecybertech.us
FRONTEND_URL=https://chat.mainecybertech.us

# Docker images (optional — defaults to ghcr.io/chat-platform/chat)
# WEB_IMAGE=ghcr.io/<owner>/chat/web:dev
# API_IMAGE=ghcr.io/<owner>/chat/api:dev

# Traefik
# ACME_EMAIL=admin@example.com
