#cloud-config
hostname: chat-${environment}
manage_etc_hosts: true

package_update: true
package_upgrade: true

packages:
  - docker.io
  - docker-compose-v2
  - ufw
  - psmisc

write_files:
  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "10m",
          "max-file": "3"
        }
      }

runcmd:
  - systemctl enable docker
  - systemctl start docker
  - mkdir -p /opt/chat
  - ufw --force enable
  - ufw allow 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp

final_message: "Chat droplet ready. Environment: ${environment}. Frontend: ${frontend_domain}, API: ${api_domain}"
