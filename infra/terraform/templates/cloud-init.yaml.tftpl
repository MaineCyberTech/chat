#cloud-config
hostname: chat-${environment}
manage_etc_hosts: true

# Don't upgrade all packages - saves time and bandwidth
package_update: true
package_upgrade: false

ssh_pwauth: false
disable_root: false
lock_passwd: true

chpasswd:
  expire: false

# Minimal packages: only Docker
packages:
  - docker.io
  - docker-compose-v2
  - docker-compose-v2

# Prevent apt from installing recommended/suggested packages
apt:
  conf: |
    APT::Install-Recommends "false";
    APT::Install-Suggests "false";

# Reduce journald disk usage
write_files:
  - path: /etc/systemd/journald.conf
    content: |
      [Journal]
      SystemMaxUse=50M
      RuntimeMaxUse=10M
      MaxFileSec=1day
  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "10m",
          "max-file": "3"
        }
      }

# Disable unnecessary services
runcmd:
  - systemctl enable docker
  - systemctl restart docker
  - systemctl restart systemd-journald
  - systemctl disable --now snapd.service snapd.socket 2>/dev/null || true
  - systemctl disable --now multipathd.service 2>/dev/null || true
  - systemctl disable --now accounts-daemon.service 2>/dev/null || true
  - systemctl disable --now polkit.service 2>/dev/null || true

final_message: "Chat droplet ready. ${environment} | ${frontend_domain} | ${api_domain}"
