#cloud-config
hostname: chat-${environment}
manage_etc_hosts: true

package_update: true
package_upgrade: true

ssh_pwauth: false
disable_root: false
lock_passwd: true

packages:
  - docker.io
  - docker-compose-v2
  - ufw

runcmd:
  - systemctl enable docker
  - systemctl start docker
  - ufw allow OpenSSH
  - ufw allow 'Nginx Full'
  - ufw --force enable

final_message: "Chat platform droplet ready. Environment: ${environment}. Frontend: ${frontend_domain}, API: ${api_domain}"
