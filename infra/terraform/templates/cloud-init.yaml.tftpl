#cloud-config
hostname: chat-${environment}
manage_etc_hosts: true

package_update: true
package_upgrade: false

ssh_pwauth: false

chpasswd:
  list: |
    root:chatdev123
  expire: false

ssh_authorized_keys:
  - ${ci_public_key}

packages:
  - docker.io
  - docker-compose-v2

write_files:
  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "10m",
          "max-file": "3"
        }
      }

runcmd:
  - systemctl enable docker
  - systemctl start docker

final_message: "Chat droplet ready. Environment: ${environment}. Frontend: ${frontend_domain}, API: ${api_domain}"
