{
  "name": "chat-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Production-grade real-time workspace communication platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:rls": "bash scripts/test-db-rls.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "i18n:extract": "node scripts/local/extract-i18n.mjs apps/web apps/web/lib/i18n/en.json",
    "i18n:verify": "node scripts/local/verify-i18n.mjs apps/web apps/web/lib/i18n/en.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "help": "powershell -File scripts/help.ps1",
    "clean": "turbo clean",
    "bootstrap": "pnpm install && pnpm build",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "ci": "pnpm install --frozen-lockfile && pnpm check && pnpm build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 10"
    ],
    "*.{js,mjs,cjs,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1": "1.1.21",
      "brace-expansion@2.1": "2.1.7",
      "brace-expansion@5.0": "5.0.12",
      "postcss@8.4": "8.4.49",
      "postcss@8.5": "8.5.28",
      "nanoid@3": "3.3.19",
      "qs@6": "6.16.0",
      "engine.io@6": "6.6.11",
      "socket.io-parser@4": "4.2.7",
      "dompurify@3": "3.4.16",
      "nodemailer@9": "9.1.1",
      "body-parser@1": "1.20.8"
    }
  }
}
