# =============================================================================
# Chat Monorepo — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# All vars below are grouped by domain with defaults and required/optional noted.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (required — both API and Web need these)
# ---------------------------------------------------------------------------
# URL of the Supabase instance (local or hosted).
# Local default: http://localhost:54321
SUPABASE_URL=http://localhost:54321

# Anon (public) key — safe for client-side use.
SUPABASE_ANON_KEY=<your-local-anon-key>

# Service role key — admin-level access, keep secret, server-side only.
SUPABASE_SERVICE_ROLE_KEY=<your-local-service-role-key>

# ---------------------------------------------------------------------------
# Node Environment (optional, defaults shown)
# ---------------------------------------------------------------------------
NODE_ENV=development              # development | production | test
LOG_LEVEL=debug                   # trace | debug | info | warn | error | fatal

# ---------------------------------------------------------------------------
# API Server (optional, defaults shown)
# ---------------------------------------------------------------------------
PORT=4000                         # Express listen port
API_BASE_URL=http://localhost:4000 # Public-facing API URL (used for links, CORS)
FRONTEND_URL=http://localhost:3000 # Frontend origin (CORS allowlist)

# ---------------------------------------------------------------------------
# Redis (optional — required for idempotency, presence, rate limiting, BullMQ)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TLS=false                   # Enable TLS for Redis connection

# ---------------------------------------------------------------------------
# Sentry (optional — error tracking)
# ---------------------------------------------------------------------------
SENTRY_DSN=                       # Sentry DSN URL
SENTRY_ENVIRONMENT=development     # Environment tag for Sentry events
NEXT_PUBLIC_SENTRY_DSN=           # Web-side Sentry DSN (optional)

# ---------------------------------------------------------------------------
# SMTP / Email (optional — for notifications)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com     # Also: EMAIL_FROM (legacy alias)

# ---------------------------------------------------------------------------
# Web Push (VAPID) — required for push notifications
# Generate with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# LiveKit (WebRTC) — required for audio/video calls
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HOST=http://localhost:7880

# ---------------------------------------------------------------------------
# JWT (optional — custom JWT secret for webhook signatures, etc.)
# Must be at least 32 characters if set
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# Rate Limiting (optional, defaults shown)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000        # Window duration in ms (default 1 min)
RATE_LIMIT_MAX_REQUESTS=100       # Max requests per window per IP

# ---------------------------------------------------------------------------
# File Uploads (optional, defaults shown)
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_MB=50               # Max upload file size in MB
UPLOAD_TTL_SECONDS=3600           # Signed upload URL TTL in seconds

# ---------------------------------------------------------------------------
# Web (Next.js) — client-side env vars (prefixed with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-local-anon-key>

# Version info (injected at build time by CI)
# NEXT_PUBLIC_APP_VERSION=
# NEXT_PUBLIC_GIT_SHA=
# NEXT_PUBLIC_BUILD_TIME=

# ---------------------------------------------------------------------------
# Infrastructure (Terraform / Cloudflare / DigitalOcean)
# ---------------------------------------------------------------------------
DO_API_TOKEN=                     # DigitalOcean API token
CF_API_TOKEN=                     # Cloudflare API token
CF_ZONE_ID=                       # Cloudflare zone ID
CF_ORIGIN_CERT=                   # Cloudflare origin certificate (PEM)
CF_ORIGIN_KEY=                    # Cloudflare origin key (PEM)
SSH_ALLOWED_IPS=                  # Comma-separated IPs allowed SSH access
ALERT_EMAIL=                      # Email for infra alerts

# AWS (used for Terraform state backend)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Supabase Hosted Project (required for CI/CD migrations and deployments)
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF=             # Supabase project reference ID
SUPABASE_DB_PASSWORD=             # Database password for migrations
SUPABASE_ACCESS_TOKEN=            # Supabase access token (CI)

# ---------------------------------------------------------------------------
# CI/CD — SSH deploy keys
# ---------------------------------------------------------------------------
CI_SSH_PUBLIC_KEY=                # Public key for CI SSH access
CI_SSH_PRIVATE_KEY=               # Private key for CI SSH access
CI_SSH_FINGERPRINT=               # SSH key fingerprint for verification
DO_SSH_PRIVATE_KEY=               # DigitalOcean droplet SSH private key
DO_SSH_PASSPHRASE=                # SSH key passphrase (if any)

# ---------------------------------------------------------------------------
# Docker Compose (dev remote / prod)
# ---------------------------------------------------------------------------
API_ORIGIN=http://api:4000        # Internal Docker network API URL
