#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Check for files larger than 5MB
echo "Checking for large files (>5MB)..."
large_files=$(git diff --cached --name-only --diff-filter=ACM | while read -r file; do
  if [ -f "$file" ] && [ "$(stat -c%s "$file" 2>/dev/null || echo 0)" -gt 5242880 ] 2>/dev/null; then
    echo "$file"
  fi
done)
if [ -n "$large_files" ]; then
  echo "ERROR: The following files exceed 5MB and cannot be committed:"
  echo "$large_files"
  echo "Please remove them or use Git LFS."
  exit 1
fi

npx lint-staged

# Check for high/critical production vulnerabilities (SUPPLY-P2-003).
# Blocking by default: fail on any HIGH/CRITICAL advisory not in the time-boxed
# exception list shared with the CI audit gate (.pnpm-audit-exceptions.json).
# Set HUSKY_AUDIT=off to bypass locally; CI still enforces the gate.
if [ "${HUSKY_AUDIT:-on}" != "off" ]; then
  echo "Checking pnpm audit for high/critical vulnerabilities..."
  pnpm audit --prod --json > .husky-audit.json 2>/dev/null || true
  node .husky/audit-gate.mjs .husky-audit.json
  audit_exit=$?
  rm -f .husky-audit.json
  if [ "$audit_exit" -ne 0 ]; then
    echo "ERROR: pnpm audit found un-allowlisted high/critical vulnerabilities (exit code $audit_exit)."
    echo "Fix them, add a tracked time-boxed entry to .pnpm-audit-exceptions.json,"
    echo "or bypass intentionally with HUSKY_AUDIT=off (CI still blocks)."
    exit "$audit_exit"
  fi
fi

exec npx --yes turbo typecheck --affected --continue